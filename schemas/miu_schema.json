{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://miudiscomhermes.org/schemas/miu.json",
  "title": "MIUdiscoHermes World Data Schema",
  "description": "Schema for miu.json - world data for Malice in Underland RPG",
  "type": "object",
  "required": ["metadata", "entries"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "version", "description", "author"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^\\d+$": {
          "type": "object",
          "required": ["key", "content"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}